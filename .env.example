# 复制为 .env 并填入本地随机值（不要提交 .env 到版本库）
# 生成方式（Git Bash / Linux）：
#   openssl rand -hex 32          -> APP_KEY
#   openssl rand -hex 16          -> POSTGRES_PASSWORD
#   openssl rand -base64 18 | tr -d '/+=' | head -c 20  -> INIT_ROOT_PASSWORD

# 应用密钥（会话加密等）
APP_KEY=replace-with-openssl-rand-hex-32

# 运行环境
APP_ENV=production

# 平台对外端口（仅绑定 127.0.0.1）；隔离测试实例可用不同端口，如 13001
APP_HOST_PORT=13000

# 时区
TZ=Asia/Shanghai

# 首次初始化语言（zh-CN / en-US）
INIT_APP_LANG=zh-CN

# 首次启动初始化的平台管理员（仅在数据库尚未安装时生效）
INIT_ROOT_EMAIL=admin@example.com
INIT_ROOT_PASSWORD=replace-with-random-password
INIT_ROOT_NICKNAME=平台管理员
INIT_ROOT_USERNAME=admin

# PostgreSQL
POSTGRES_USER=nocobase
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16
POSTGRES_DB=nocobase

# 演示业务账号密码（虚构员工/账号，仅本地演示）
DEMO_PASSWORD=replace-with-demo-password

# 隔离测试目标：NB_* 三个变量必须一起显式设置，属于同一个独立 Compose 项目。
# 写入测试在执行前拒绝缺省目标、主实例、错配项目及非回环地址。
# 以下以项目 hris-check、端口 13002 为例，完整操作见 docs/operations/REPRODUCE.md。
# NB_BASE=http://127.0.0.1:13002
# NB_APP_CONTAINER=hris-check-app-1
# NB_DB_CONTAINER=hris-check-postgres-1
# 仅在隔离业务套件验证事务回滚时临时开启：
# HRIS_ALLOW_FAULT_INJECT=1
